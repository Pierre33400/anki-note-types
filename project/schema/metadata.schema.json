{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anki note type metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "stylesheet", "fields"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "stylesheet": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
